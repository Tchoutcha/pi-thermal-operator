FROM --platform=$BUILDPLATFORM golang:1.27 AS build
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -o /agent ./cmd/agent

FROM gcr.io/distroless/static
COPY --from=build /agent /agent
ENTRYPOINT ["/agent"]
